      Executed DbCommand (1ms) [Parameters=[@id='?' (DbType = Int32), @sectionId_Value='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT "t"."Id", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId", "c"."Id", "c"."BibColour", "c"."CreatedAt", "c"."Name", "c"."Region", "s"."Id", "s"."Eliminated", "s"."Placing", "s"."Points", "s"."RaceId", "s"."RecordedAt", "s"."RecordedByUserId", "s"."TeamId", "s"."Id0", "s"."FinishedAt", "s"."HeatId", "s"."IsComplete", "s"."Name", "s"."OrderIndex", "s"."StartedAt"
      FROM "Teams" AS "t"
      INNER JOIN "Clubs" AS "c" ON "t"."ClubId" = "c"."Id"
      LEFT JOIN (
          SELECT "r"."Id", "r"."Eliminated", "r"."Placing", "r"."Points", "r"."RaceId", "r"."RecordedAt", "r"."RecordedByUserId", "r"."TeamId", "r0"."Id" AS "Id0", "r0"."FinishedAt", "r0"."HeatId", "r0"."IsComplete", "r0"."Name", "r0"."OrderIndex", "r0"."StartedAt"
          FROM "Results" AS "r"
          INNER JOIN "Races" AS "r0" ON "r"."RaceId" = "r0"."Id"
      ) AS "s" ON "t"."Id" = "s"."TeamId"
      WHERE "t"."CompetitionId" = @id AND NOT ("t"."IsHorsConcours") AND "t"."CompetitionSectionId" = @sectionId_Value
      ORDER BY "t"."Id", "c"."Id", "s"."Id"
