      Executed DbCommand (0ms) [Parameters=[@team_Id='?' (DbType = Int32), @userId='?' (Size = 36)], CommandType='Text', CommandTimeout='30']
      SELECT "t"."Id", "t"."CreatedAt", "t"."Status", "t"."TeamId", "t"."UserId", "t0"."Id", "t0"."BibColour", "t0"."ClubId", "t0"."CompetitionId", "t0"."CompetitionSectionId", "t0"."CreatedAt", "t0"."DisplayName", "t0"."IsHorsConcours", "t0"."Suffix", "t0"."SupporterJoinKey", "t0"."TrainerUserId", "a"."Id", "a"."AccessFailedCount", "a"."ClubId", "a"."ConcurrencyStamp", "a"."CreatedAt", "a"."Email", "a"."EmailConfirmed", "a"."FullName", "a"."LockoutEnabled", "a"."LockoutEnd", "a"."NormalizedEmail", "a"."NormalizedUserName", "a"."PasswordHash", "a"."PhoneNumber", "a"."PhoneNumberConfirmed", "a"."SecurityStamp", "a"."TwoFactorEnabled", "a"."UserName"
      FROM "TeamSupporters" AS "t"
      INNER JOIN "Teams" AS "t0" ON "t"."TeamId" = "t0"."Id"
      INNER JOIN "AspNetUsers" AS "a" ON "t"."UserId" = "a"."Id"
      WHERE "t"."TeamId" = @team_Id AND "t"."UserId" = @userId
      LIMIT 1
