      SELECT "s0"."Id", "s0"."DurationMinutes", "s0"."FinishedAt", "s0"."Label", "s0"."OrderIndex", "s0"."RaceRoundId", "s0"."RaceRoundStage", "s0"."ScheduledStart", "s0"."SessionId", "s0"."StartedAt", "s0"."Id0", "s0"."ArenaName", "s0"."CompetitionId", "s0"."CompetitionSectionId", "s0"."DurationMinutes0", "s0"."FinishedAt0", "s0"."IsBreak", "s0"."Kind", "s0"."LanesPerHeat", "s0"."Location", "s0"."MinutesPerHeat", "s0"."Name", "s0"."Notes", "s0"."OrderIndex0", "s0"."RaceOrderAlternating", "s0"."ScheduledStart0", "s0"."StartedAt0", "s0"."Status", "s0"."StreamUrl", "h0"."Id", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt"
      FROM (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "s"."Id" AS "Id0", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes" AS "DurationMinutes0", "s"."FinishedAt" AS "FinishedAt0", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex" AS "OrderIndex0", "s"."RaceOrderAlternating", "s"."ScheduledStart" AS "ScheduledStart0", "s"."StartedAt" AS "StartedAt0", "s"."Status", "s"."StreamUrl"
          FROM "Heats" AS "h"
          INNER JOIN "Sessions" AS "s" ON "h"."SessionId" = "s"."Id"
          WHERE "h"."Id" = @heatId AND "h"."SessionId" = @id
          LIMIT 1
      ) AS "s0"
      LEFT JOIN "HeatEntries" AS "h0" ON "s0"."Id" = "h0"."HeatId"
      LEFT JOIN "Races" AS "r" ON "s0"."Id" = "r"."HeatId"
      ORDER BY "s0"."Id", "s0"."Id0", "h0"."Id"
