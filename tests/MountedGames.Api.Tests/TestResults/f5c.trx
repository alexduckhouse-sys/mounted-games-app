      SELECT "s0"."Id", "s0"."ArenaName", "s0"."CompetitionId", "s0"."CompetitionSectionId", "s0"."DurationMinutes", "s0"."FinishedAt", "s0"."IsBreak", "s0"."Kind", "s0"."LanesPerHeat", "s0"."Location", "s0"."MinutesPerHeat", "s0"."Name", "s0"."Notes", "s0"."OrderIndex", "s0"."RaceOrderAlternating", "s0"."ScheduledStart", "s0"."StartedAt", "s0"."Status", "s0"."StreamUrl", "s2"."Id", "s2"."DurationMinutes", "s2"."FinishedAt", "s2"."Label", "s2"."OrderIndex", "s2"."RaceRoundId", "s2"."RaceRoundStage", "s2"."ScheduledStart", "s2"."SessionId", "s2"."StartedAt", "s2"."Id0", "s2"."HeatId", "s2"."LaneIndex", "s2"."TeamId", "s2"."Id1", "s2"."FinishedAt0", "s2"."HeatId0", "s2"."IsComplete", "s2"."Name", "s2"."OrderIndex0", "s2"."StartedAt0", "s2"."Id00", "s2"."Eliminated", "s2"."Placing", "s2"."Points", "s2"."RaceId", "s2"."RecordedAt", "s2"."RecordedByUserId", "s2"."TeamId0"
      FROM (
          SELECT "s"."Id", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes", "s"."FinishedAt", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex", "s"."RaceOrderAlternating", "s"."ScheduledStart", "s"."StartedAt", "s"."Status", "s"."StreamUrl"
          FROM "Sessions" AS "s"
          WHERE "s"."Id" = @id AND "s"."CompetitionId" = @competitionId
          LIMIT 1
      ) AS "s0"
      LEFT JOIN (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "h0"."Id" AS "Id0", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "s1"."Id" AS "Id1", "s1"."FinishedAt" AS "FinishedAt0", "s1"."HeatId" AS "HeatId0", "s1"."IsComplete", "s1"."Name", "s1"."OrderIndex" AS "OrderIndex0", "s1"."StartedAt" AS "StartedAt0", "s1"."Id0" AS "Id00", "s1"."Eliminated", "s1"."Placing", "s1"."Points", "s1"."RaceId", "s1"."RecordedAt", "s1"."RecordedByUserId", "s1"."TeamId" AS "TeamId0"
          FROM "Heats" AS "h"
          LEFT JOIN "HeatEntries" AS "h0" ON "h"."Id" = "h0"."HeatId"
          LEFT JOIN (
              SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "r0"."Id" AS "Id0", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId"
              FROM "Races" AS "r"
              LEFT JOIN "Results" AS "r0" ON "r"."Id" = "r0"."RaceId"
          ) AS "s1" ON "h"."Id" = "s1"."HeatId"
      ) AS "s2" ON "s0"."Id" = "s2"."SessionId"
      ORDER BY "s0"."Id", "s2"."Id", "s2"."Id0", "s2"."Id1"
