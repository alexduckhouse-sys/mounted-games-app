          WHERE "s"."Id" = @id AND "s"."CompetitionId" = @competitionId
          LIMIT 1
      ) AS "s0"
      LEFT JOIN (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "s1"."Id" AS "Id0", "s1"."HeatId", "s1"."LaneIndex", "s1"."TeamId", "s1"."Id0" AS "Id00", "s1"."BibColour", "s1"."ClubId", "s1"."CompetitionId", "s1"."CompetitionSectionId", "s1"."CreatedAt", "s1"."DisplayName", "s1"."IsHorsConcours", "s1"."Suffix", "s1"."SupporterJoinKey", "s1"."TrainerUserId", "s3"."Id" AS "Id1", "s3"."FinishedAt" AS "FinishedAt0", "s3"."HeatId" AS "HeatId0", "s3"."IsComplete", "s3"."Name", "s3"."OrderIndex" AS "OrderIndex0", "s3"."StartedAt" AS "StartedAt0", "s3"."Id0" AS "Id01", "s3"."Eliminated", "s3"."Placing", "s3"."Points", "s3"."RaceId", "s3"."RecordedAt", "s3"."RecordedByUserId", "s3"."TeamId" AS "TeamId0", "s3"."Id00" AS "Id000", "s3"."BibColour" AS "BibColour0", "s3"."ClubId" AS "ClubId0", "s3"."CompetitionId" AS "CompetitionId0", "s3"."CompetitionSectionId" AS "CompetitionSectionId0", "s3"."CreatedAt" AS "CreatedAt0", "s3"."DisplayName" AS "DisplayName0", "s3"."IsHorsConcours" AS "IsHorsConcours0", "s3"."Suffix" AS "Suffix0", "s3"."SupporterJoinKey" AS "SupporterJoinKey0", "s3"."TrainerUserId" AS "TrainerUserId0"
          FROM "Heats" AS "h"
