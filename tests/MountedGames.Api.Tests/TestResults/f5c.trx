      SELECT "s0"."Id", "s0"."AgeGroup", "s0"."CompetitionId", "s0"."CreatedAt", "s0"."DisplayName", "s0"."FinalistCount", "s0"."Format", "s0"."MaxParticipants", "s0"."PriceMinor", "s0"."RunoffRaceName", "s0"."UsesRaceFinals", "s0"."Id0", "s0"."AppleMapsUrl", "s0"."CreatedAt0", "s0"."CreatedByUserId", "s0"."Description", "s0"."EndDate", "s0"."Icon", "s0"."IsActive", "s0"."IsArchived", "s0"."Latitude", "s0"."Location", "s0"."Longitude", "s0"."Name", "s0"."OrganiserName", "s0"."PaymentDestination", "s0"."SignupsLocked", "s0"."StartDate", "s0"."StreamUrl", "s0"."What3Words", "s"."Id", "s"."AmountMinor", "s"."CompetitionSectionId", "s"."ContactInfo", "s"."CreatedAt", "s"."FullName", "s"."PaidAt", "s"."PonyClubName", "s"."Status", "s"."TeamId", "s"."UserId"
      FROM (
          SELECT "c"."Id", "c"."AgeGroup", "c"."CompetitionId", "c"."CreatedAt", "c"."DisplayName", "c"."FinalistCount", "c"."Format", "c"."MaxParticipants", "c"."PriceMinor", "c"."RunoffRaceName", "c"."UsesRaceFinals", "c0"."Id" AS "Id0", "c0"."AppleMapsUrl", "c0"."CreatedAt" AS "CreatedAt0", "c0"."CreatedByUserId", "c0"."Description", "c0"."EndDate", "c0"."Icon", "c0"."IsActive", "c0"."IsArchived", "c0"."Latitude", "c0"."Location", "c0"."Longitude", "c0"."Name", "c0"."OrganiserName", "c0"."PaymentDestination", "c0"."SignupsLocked", "c0"."StartDate", "c0"."StreamUrl", "c0"."What3Words"
          FROM "CompetitionSections" AS "c"
          INNER JOIN "Competitions" AS "c0" ON "c"."CompetitionId" = "c0"."Id"
          WHERE "c"."Id" = @sectionId AND "c"."CompetitionId" = @competitionId
          LIMIT 1
      ) AS "s0"
      LEFT JOIN "SectionSignups" AS "s" ON "s0"."Id" = "s"."CompetitionSectionId"
      ORDER BY "s0"."Id", "s0"."Id0"
