      SELECT "d"."Id", "d"."IsLocked", "d"."Notes", "d"."SubmittedAt", "d"."SubmittedByUserId", "d"."TeamId", "t"."Id", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId", "c"."Id", "c"."AppleMapsUrl", "c"."CreatedAt", "c"."CreatedByUserId", "c"."Description", "c"."EndDate", "c"."Icon", "c"."IsActive", "c"."IsArchived", "c"."Latitude", "c"."Location", "c"."Longitude", "c"."Name", "c"."OrganiserName", "c"."PaymentDestination", "c"."SignupsLocked", "c"."StartDate", "c"."StreamUrl", "c"."What3Words", "a"."Id", "a"."AccessFailedCount", "a"."ClubId", "a"."ConcurrencyStamp", "a"."CreatedAt", "a"."Email", "a"."EmailConfirmed", "a"."FullName", "a"."LockoutEnabled", "a"."LockoutEnd", "a"."NormalizedEmail", "a"."NormalizedUserName", "a"."PasswordHash", "a"."PhoneNumber", "a"."PhoneNumberConfirmed", "a"."SecurityStamp", "a"."TwoFactorEnabled", "a"."UserName", "r"."Id", "r"."BibColour", "r"."DateOfBirth", "r"."DeclarationFormId", "r"."FullName", "r"."HorseName", "r"."IsCaptain", "r"."IsReserve", "r"."OrderIndex", "r"."SavedRiderId"
      FROM "DeclarationForms" AS "d"
      INNER JOIN "Teams" AS "t" ON "d"."TeamId" = "t"."Id"
      INNER JOIN "Competitions" AS "c" ON "t"."CompetitionId" = "c"."Id"
      LEFT JOIN "AspNetUsers" AS "a" ON "d"."SubmittedByUserId" = "a"."Id"
      LEFT JOIN "RiderEntries" AS "r" ON "d"."Id" = "r"."DeclarationFormId"
      WHERE "d"."IsLocked" AND "t"."CompetitionId" = @competitionId
      ORDER BY "d"."SubmittedAt" DESC, "d"."Id", "t"."Id", "c"."Id", "a"."Id"
