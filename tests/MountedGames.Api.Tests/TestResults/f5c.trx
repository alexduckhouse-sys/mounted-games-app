      SELECT "s"."Id", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes", "s"."FinishedAt", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex", "s"."RaceOrderAlternating", "s"."ScheduledStart", "s"."StartedAt", "s"."Status", "s"."StreamUrl", "s0"."Id", "s0"."DurationMinutes", "s0"."FinishedAt", "s0"."Label", "s0"."OrderIndex", "s0"."RaceRoundId", "s0"."RaceRoundStage", "s0"."ScheduledStart", "s0"."SessionId", "s0"."StartedAt", "s0"."Id0", "s0"."HeatId", "s0"."LaneIndex", "s0"."TeamId", "s0"."Id1", "s0"."FinishedAt0", "s0"."HeatId0", "s0"."IsComplete", "s0"."Name", "s0"."OrderIndex0", "s0"."StartedAt0"
      FROM "Sessions" AS "s"
      LEFT JOIN (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "h0"."Id" AS "Id0", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "r"."Id" AS "Id1", "r"."FinishedAt" AS "FinishedAt0", "r"."HeatId" AS "HeatId0", "r"."IsComplete", "r"."Name", "r"."OrderIndex" AS "OrderIndex0", "r"."StartedAt" AS "StartedAt0"
          FROM "Heats" AS "h"
          LEFT JOIN "HeatEntries" AS "h0" ON "h"."Id" = "h0"."HeatId"
          LEFT JOIN "Races" AS "r" ON "h"."Id" = "r"."HeatId"
      ) AS "s0" ON "s"."Id" = "s0"."SessionId"
      WHERE "s"."CompetitionId" = @competitionId AND "s"."Kind" = 0
      ORDER BY "s"."Id", "s0"."Id", "s0"."Id0"
