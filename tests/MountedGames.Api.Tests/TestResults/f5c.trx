      SELECT "s"."Id", "s"."IsLocked", "s"."Notes", "s"."SubmittedAt", "s"."SubmittedByUserId", "s"."TeamId", "s"."Id0", "s"."BibColour", "s"."ClubId", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."CreatedAt", "s"."DisplayName", "s"."IsHorsConcours", "s"."Suffix", "s"."SupporterJoinKey", "s"."TrainerUserId", "s"."Id1", "s"."AppleMapsUrl", "s"."CreatedAt0", "s"."CreatedByUserId", "s"."Description", "s"."EndDate", "s"."Icon", "s"."IsActive", "s"."IsArchived", "s"."Latitude", "s"."Location", "s"."Longitude", "s"."Name", "s"."OrganiserName", "s"."PaymentDestination", "s"."SignupsLocked", "s"."StartDate", "s"."StreamUrl", "s"."What3Words", "s"."Id2", "s"."AccessFailedCount", "s"."ClubId0", "s"."ConcurrencyStamp", "s"."CreatedAt1", "s"."Email", "s"."EmailConfirmed", "s"."FullName", "s"."LockoutEnabled", "s"."LockoutEnd", "s"."NormalizedEmail", "s"."NormalizedUserName", "s"."PasswordHash", "s"."PhoneNumber", "s"."PhoneNumberConfirmed", "s"."SecurityStamp", "s"."TwoFactorEnabled", "s"."UserName", "r"."Id", "r"."BibColour", "r"."DateOfBirth", "r"."DeclarationFormId", "r"."FullName", "r"."HorseName", "r"."IsCaptain", "r"."IsReserve", "r"."OrderIndex", "r"."SavedRiderId"
      FROM (
          SELECT "d"."Id", "d"."IsLocked", "d"."Notes", "d"."SubmittedAt", "d"."SubmittedByUserId", "d"."TeamId", "t"."Id" AS "Id0", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId", "c"."Id" AS "Id1", "c"."AppleMapsUrl", "c"."CreatedAt" AS "CreatedAt0", "c"."CreatedByUserId", "c"."Description", "c"."EndDate", "c"."Icon", "c"."IsActive", "c"."IsArchived", "c"."Latitude", "c"."Location", "c"."Longitude", "c"."Name", "c"."OrganiserName", "c"."PaymentDestination", "c"."SignupsLocked", "c"."StartDate", "c"."StreamUrl", "c"."What3Words", "a"."Id" AS "Id2", "a"."AccessFailedCount", "a"."ClubId" AS "ClubId0", "a"."ConcurrencyStamp", "a"."CreatedAt" AS "CreatedAt1", "a"."Email", "a"."EmailConfirmed", "a"."FullName", "a"."LockoutEnabled", "a"."LockoutEnd", "a"."NormalizedEmail", "a"."NormalizedUserName", "a"."PasswordHash", "a"."PhoneNumber", "a"."PhoneNumberConfirmed", "a"."SecurityStamp", "a"."TwoFactorEnabled", "a"."UserName"
          FROM "DeclarationForms" AS "d"
          INNER JOIN "Teams" AS "t" ON "d"."TeamId" = "t"."Id"
          INNER JOIN "Competitions" AS "c" ON "t"."CompetitionId" = "c"."Id"
          LEFT JOIN "AspNetUsers" AS "a" ON "d"."SubmittedByUserId" = "a"."Id"
          WHERE "d"."Id" = @id
          LIMIT 1
      ) AS "s"
      LEFT JOIN "RiderEntries" AS "r" ON "s"."Id" = "r"."DeclarationFormId"
      ORDER BY "s"."Id", "s"."Id0", "s"."Id1", "s"."Id2"
