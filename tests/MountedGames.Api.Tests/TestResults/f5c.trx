      FROM (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt"
          FROM "Heats" AS "h"
          WHERE "h"."Id" = @heatId
          LIMIT 1
      ) AS "h1"
      LEFT JOIN (
          SELECT "h0"."Id", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "t"."Id" AS "Id0", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId"
          FROM "HeatEntries" AS "h0"
          INNER JOIN "Teams" AS "t" ON "h0"."TeamId" = "t"."Id"
      ) AS "s" ON "h1"."Id" = "s"."HeatId"
      LEFT JOIN (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "s0"."Id" AS "Id0", "s0"."Eliminated", "s0"."Placing", "s0"."Points", "s0"."RaceId", "s0"."RecordedAt", "s0"."RecordedByUserId", "s0"."TeamId", "s0"."Id0" AS "Id00", "s0"."BibColour", "s0"."ClubId", "s0"."CompetitionId", "s0"."CompetitionSectionId", "s0"."CreatedAt", "s0"."DisplayName", "s0"."IsHorsConcours", "s0"."Suffix", "s0"."SupporterJoinKey", "s0"."TrainerUserId"
          FROM "Races" AS "r"
          LEFT JOIN (
              SELECT "r0"."Id", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId", "t0"."Id" AS "Id0", "t0"."BibColour", "t0"."ClubId", "t0"."CompetitionId", "t0"."CompetitionSectionId", "t0"."CreatedAt", "t0"."DisplayName", "t0"."IsHorsConcours", "t0"."Suffix", "t0"."SupporterJoinKey", "t0"."TrainerUserId"
              FROM "Results" AS "r0"
