      SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "s"."Id", "s"."FinishedAt", "s"."HeatId", "s"."IsComplete", "s"."Name", "s"."OrderIndex", "s"."StartedAt", "s"."Id0", "s"."Eliminated", "s"."Placing", "s"."Points", "s"."RaceId", "s"."RecordedAt", "s"."RecordedByUserId", "s"."TeamId"
      FROM "Heats" AS "h"
      LEFT JOIN (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "r0"."Id" AS "Id0", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId"
          FROM "Races" AS "r"
          LEFT JOIN "Results" AS "r0" ON "r"."Id" = "r0"."RaceId"
      ) AS "s" ON "h"."Id" = "s"."HeatId"
      WHERE "h"."SessionId" = @id AND "h"."RaceRoundId" = @finalHeat_RaceRoundId AND "h"."RaceRoundStage" = 1
      ORDER BY "h"."OrderIndex", "h"."Id", "s"."Id"
