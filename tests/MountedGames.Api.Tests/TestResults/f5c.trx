      SELECT "t"."Id", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId", "h"."Id", "h"."HeatId", "h"."LaneIndex", "h"."TeamId", "d"."Id", "d"."IsLocked", "d"."Notes", "d"."SubmittedAt", "d"."SubmittedByUserId", "d"."TeamId"
      FROM "Teams" AS "t"
      LEFT JOIN "HeatEntries" AS "h" ON "t"."Id" = "h"."TeamId"
