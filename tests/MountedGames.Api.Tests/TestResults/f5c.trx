      FROM (
          SELECT "s"."Id", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes", "s"."FinishedAt", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex", "s"."RaceOrderAlternating", "s"."ScheduledStart", "s"."StartedAt", "s"."Status", "s"."StreamUrl", "c"."Id" AS "Id0", "c"."AgeGroup", "c"."CompetitionId" AS "CompetitionId0", "c"."CreatedAt", "c"."DisplayName", "c"."FinalistCount", "c"."Format", "c"."MaxParticipants", "c"."PriceMinor", "c"."RunoffRaceName", "c"."UsesRaceFinals"
          FROM "Sessions" AS "s"
