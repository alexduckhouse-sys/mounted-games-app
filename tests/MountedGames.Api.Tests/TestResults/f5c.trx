      Executed DbCommand (1ms) [Parameters=[@raceId='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']
      SELECT "s0"."Id", "s0"."FinishedAt", "s0"."HeatId", "s0"."IsComplete", "s0"."Name", "s0"."OrderIndex", "s0"."StartedAt", "s0"."Id0", "s0"."DurationMinutes", "s0"."FinishedAt0", "s0"."Label", "s0"."OrderIndex0", "s0"."RaceRoundId", "s0"."RaceRoundStage", "s0"."ScheduledStart", "s0"."SessionId", "s0"."StartedAt0", "s0"."Id1", "s0"."ArenaName", "s0"."CompetitionId", "s0"."CompetitionSectionId", "s0"."DurationMinutes0", "s0"."FinishedAt1", "s0"."IsBreak", "s0"."Kind", "s0"."LanesPerHeat", "s0"."Location", "s0"."MinutesPerHeat", "s0"."Name0", "s0"."Notes", "s0"."OrderIndex1", "s0"."RaceOrderAlternating", "s0"."ScheduledStart0", "s0"."StartedAt1", "s0"."Status", "s0"."StreamUrl", "s1"."Id", "s1"."Eliminated", "s1"."Placing", "s1"."Points", "s1"."RaceId", "s1"."RecordedAt", "s1"."RecordedByUserId", "s1"."TeamId", "s1"."Id0", "s1"."BibColour", "s1"."ClubId", "s1"."CompetitionId", "s1"."CompetitionSectionId", "s1"."CreatedAt", "s1"."DisplayName", "s1"."IsHorsConcours", "s1"."Suffix", "s1"."SupporterJoinKey", "s1"."TrainerUserId"
      FROM (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "h"."Id" AS "Id0", "h"."DurationMinutes", "h"."FinishedAt" AS "FinishedAt0", "h"."Label", "h"."OrderIndex" AS "OrderIndex0", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt" AS "StartedAt0", "s"."Id" AS "Id1", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes" AS "DurationMinutes0", "s"."FinishedAt" AS "FinishedAt1", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name" AS "Name0", "s"."Notes", "s"."OrderIndex" AS "OrderIndex1", "s"."RaceOrderAlternating", "s"."ScheduledStart" AS "ScheduledStart0", "s"."StartedAt" AS "StartedAt1", "s"."Status", "s"."StreamUrl"
          FROM "Races" AS "r"
          INNER JOIN "Heats" AS "h" ON "r"."HeatId" = "h"."Id"
          INNER JOIN "Sessions" AS "s" ON "h"."SessionId" = "s"."Id"
          WHERE "r"."Id" = @raceId
          LIMIT 1
      ) AS "s0"
      LEFT JOIN (
          SELECT "r0"."Id", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId", "t"."Id" AS "Id0", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId"
          FROM "Results" AS "r0"
          INNER JOIN "Teams" AS "t" ON "r0"."TeamId" = "t"."Id"
      ) AS "s1" ON "s0"."Id" = "s1"."RaceId"
      ORDER BY "s0"."Id", "s0"."Id0", "s0"."Id1", "s1"."Id"
