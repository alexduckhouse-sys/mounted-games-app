          SELECT "r0"."Id", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId", "t1"."Id" AS "Id0", "t1"."BibColour", "t1"."ClubId", "t1"."CompetitionId", "t1"."CompetitionSectionId", "t1"."CreatedAt", "t1"."DisplayName", "t1"."IsHorsConcours", "t1"."Suffix", "t1"."SupporterJoinKey", "t1"."TrainerUserId"
