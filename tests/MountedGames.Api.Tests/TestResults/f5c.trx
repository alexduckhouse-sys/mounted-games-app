      SELECT "s"."Id", "s"."FinishedAt", "s"."HeatId", "s"."IsComplete", "s"."Name", "s"."OrderIndex", "s"."StartedAt", "s"."Id0", "s"."DurationMinutes", "s"."FinishedAt0", "s"."Label", "s"."OrderIndex0", "s"."RaceRoundId", "s"."RaceRoundStage", "s"."ScheduledStart", "s"."SessionId", "s"."StartedAt0", "h0"."Id", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "r0"."Id", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId"
      FROM (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "h"."Id" AS "Id0", "h"."DurationMinutes", "h"."FinishedAt" AS "FinishedAt0", "h"."Label", "h"."OrderIndex" AS "OrderIndex0", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt" AS "StartedAt0"
          FROM "Races" AS "r"
          INNER JOIN "Heats" AS "h" ON "r"."HeatId" = "h"."Id"
          WHERE "r"."Id" = @raceId
          LIMIT 1
      ) AS "s"
      LEFT JOIN "HeatEntries" AS "h0" ON "s"."Id0" = "h0"."HeatId"
      LEFT JOIN "Results" AS "r0" ON "s"."Id" = "r0"."RaceId"
      ORDER BY "s"."Id", "s"."Id0", "h0"."Id"
