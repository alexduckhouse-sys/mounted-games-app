      FROM (
          SELECT "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt", "s"."Id" AS "Id0", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes" AS "DurationMinutes0", "s"."FinishedAt" AS "FinishedAt0", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex" AS "OrderIndex0", "s"."RaceOrderAlternating", "s"."ScheduledStart" AS "ScheduledStart0", "s"."StartedAt" AS "StartedAt0", "s"."Status", "s"."StreamUrl"
          FROM "Heats" AS "h"
          INNER JOIN "Sessions" AS "s" ON "h"."SessionId" = "s"."Id"
          WHERE "h"."Id" = @heatId AND "h"."SessionId" = @id
          LIMIT 1
      ) AS "s0"
      LEFT JOIN (
          SELECT "h0"."Id", "h0"."HeatId", "h0"."LaneIndex", "h0"."TeamId", "t"."Id" AS "Id0", "t"."BibColour", "t"."ClubId", "t"."CompetitionId", "t"."CompetitionSectionId", "t"."CreatedAt", "t"."DisplayName", "t"."IsHorsConcours", "t"."Suffix", "t"."SupporterJoinKey", "t"."TrainerUserId"
          FROM "HeatEntries" AS "h0"
          INNER JOIN "Teams" AS "t" ON "h0"."TeamId" = "t"."Id"
      ) AS "s1" ON "s0"."Id" = "s1"."HeatId"
      LEFT JOIN (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "s2"."Id" AS "Id0", "s2"."Eliminated", "s2"."Placing", "s2"."Points", "s2"."RaceId", "s2"."RecordedAt", "s2"."RecordedByUserId", "s2"."TeamId", "s2"."Id0" AS "Id00", "s2"."BibColour", "s2"."ClubId", "s2"."CompetitionId", "s2"."CompetitionSectionId", "s2"."CreatedAt", "s2"."DisplayName", "s2"."IsHorsConcours", "s2"."Suffix", "s2"."SupporterJoinKey", "s2"."TrainerUserId"
          FROM "Races" AS "r"
          LEFT JOIN (
              SELECT "r0"."Id", "r0"."Eliminated", "r0"."Placing", "r0"."Points", "r0"."RaceId", "r0"."RecordedAt", "r0"."RecordedByUserId", "r0"."TeamId", "t0"."Id" AS "Id0", "t0"."BibColour", "t0"."ClubId", "t0"."CompetitionId", "t0"."CompetitionSectionId", "t0"."CreatedAt", "t0"."DisplayName", "t0"."IsHorsConcours", "t0"."Suffix", "t0"."SupporterJoinKey", "t0"."TrainerUserId"
              FROM "Results" AS "r0"
              INNER JOIN "Teams" AS "t0" ON "r0"."TeamId" = "t0"."Id"
          ) AS "s2" ON "r"."Id" = "s2"."RaceId"
      ) AS "s3" ON "s0"."Id" = "s3"."HeatId"
      ORDER BY "s0"."Id", "s0"."Id0", "s1"."Id", "s1"."Id0", "s3"."Id", "s3"."Id0"
