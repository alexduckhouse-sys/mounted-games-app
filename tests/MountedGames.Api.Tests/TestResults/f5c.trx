          ) AS "s1" ON "h"."Id" = "s1"."HeatId"
          LEFT JOIN (
              SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "s2"."Id" AS "Id0", "s2"."Eliminated", "s2"."Placing", "s2"."Points", "s2"."RaceId", "s2"."RecordedAt", "s2"."RecordedByUserId", "s2"."TeamId", "s2"."Id0" AS "Id00", "s2"."BibColour", "s2"."ClubId", "s2"."CompetitionId", "s2"."CompetitionSectionId", "s2"."CreatedAt", "s2"."DisplayName", "s2"."IsHorsConcours", "s2"."Suffix", "s2"."SupporterJoinKey", "s2"."TrainerUserId"
              FROM "Races" AS "r"
