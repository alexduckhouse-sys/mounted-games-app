      FROM (
          SELECT "r"."Id", "r"."FinishedAt", "r"."HeatId", "r"."IsComplete", "r"."Name", "r"."OrderIndex", "r"."StartedAt", "h"."Id" AS "Id0", "h"."DurationMinutes", "h"."FinishedAt" AS "FinishedAt0", "h"."Label", "h"."OrderIndex" AS "OrderIndex0", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt" AS "StartedAt0", "s"."Id" AS "Id1", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes" AS "DurationMinutes0", "s"."FinishedAt" AS "FinishedAt1", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name" AS "Name0", "s"."Notes", "s"."OrderIndex" AS "OrderIndex1", "s"."RaceOrderAlternating", "s"."ScheduledStart" AS "ScheduledStart0", "s"."StartedAt" AS "StartedAt1", "s"."Status", "s"."StreamUrl"
