      SELECT "s0"."Id", "s0"."ArenaName", "s0"."CompetitionId", "s0"."CompetitionSectionId", "s0"."DurationMinutes", "s0"."FinishedAt", "s0"."IsBreak", "s0"."Kind", "s0"."LanesPerHeat", "s0"."Location", "s0"."MinutesPerHeat", "s0"."Name", "s0"."Notes", "s0"."OrderIndex", "s0"."RaceOrderAlternating", "s0"."ScheduledStart", "s0"."StartedAt", "s0"."Status", "s0"."StreamUrl", "h"."Id", "h"."DurationMinutes", "h"."FinishedAt", "h"."Label", "h"."OrderIndex", "h"."RaceRoundId", "h"."RaceRoundStage", "h"."ScheduledStart", "h"."SessionId", "h"."StartedAt"
      FROM (
          SELECT "s"."Id", "s"."ArenaName", "s"."CompetitionId", "s"."CompetitionSectionId", "s"."DurationMinutes", "s"."FinishedAt", "s"."IsBreak", "s"."Kind", "s"."LanesPerHeat", "s"."Location", "s"."MinutesPerHeat", "s"."Name", "s"."Notes", "s"."OrderIndex", "s"."RaceOrderAlternating", "s"."ScheduledStart", "s"."StartedAt", "s"."Status", "s"."StreamUrl"
