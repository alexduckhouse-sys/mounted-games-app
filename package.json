{
  "name": "mounted-games-app",
  "private": true,
  "scripts": {
    "build": "npm --prefix web run build && dotnet build api/MountedGames.Api.csproj",
    "dev": "npm --prefix web run dev --",
    "start": "node scripts/api.mjs",
    "db:migrate": "node scripts/api.mjs --migrate",
    "db:seed-review": "node scripts/api.mjs --seed-review",
    "db:reseed-review": "node scripts/api.mjs --reseed-review",
    "test:neon": "node scripts/verify-neon.mjs",
    "test": "npm --prefix web test && dotnet test tests/MountedGames.Api.Tests/MountedGames.Api.Tests.csproj"
  },
  "dependencies": {
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2"
  }
}
